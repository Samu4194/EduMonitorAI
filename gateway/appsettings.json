{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "usuarios",
        "Match": {
          "Path": "/api/auth/{**rest}"
        }
      },
      "docentes": {
        "ClusterId": "usuarios",
        "Match": {
          "Path": "/api/docentes/{**rest}"
        }
      },
      "materias": {
        "ClusterId": "materias",
        "Match": {
          "Path": "/api/materias/{**rest}"
        }
      },
      "estudiantes": {
        "ClusterId": "estudiantes",
        "Match": {
          "Path": "/api/estudiantes/{**rest}"
        }
      },
      "matriculas": {
        "ClusterId": "estudiantes",
        "Match": {
          "Path": "/api/matriculas/{**rest}"
        }
      }
    },
    "Clusters": {
      "usuarios": {
        "Destinations": {
          "api": {
            "Address": "http://usuarios:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        }
      },
      "materias": {
        "Destinations": {
          "api": {
            "Address": "http://materias:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        }
      },
      "estudiantes": {
        "Destinations": {
          "api": {
            "Address": "http://estudiantes:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        }
      }
    }
  }
}
