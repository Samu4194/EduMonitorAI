{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "moodle": {
        "ClusterId": "evaluaciones",
        "Match": { "Path": "/api/moodle/{**rest}" }
      },
      "auth": {
        "ClusterId": "usuarios",
        "Match": {
          "Path": "/api/auth/{**rest}"
        }
      },
      "docentes": {
        "ClusterId": "usuarios",
        "Match": {
          "Path": "/api/docentes/{**rest}"
        }
      },
      "carreras": {
        "ClusterId": "materias",
        "Match": {
          "Path": "/api/carreras/{**rest}"
        }
      },
      "periodos": {
        "ClusterId": "materias",
        "Match": {
          "Path": "/api/periodos/{**rest}"
        }
      },
      "paralelos": {
        "ClusterId": "materias",
        "Match": {
          "Path": "/api/paralelos/{**rest}"
        }
      },
      "cursos": {
        "ClusterId": "materias",
        "Match": {
          "Path": "/api/cursos/{**rest}"
        }
      },
      "estudiantes": {
        "ClusterId": "estudiantes",
        "Match": {
          "Path": "/api/estudiantes/{**rest}"
        }
      },
      "unidades": {
        "ClusterId": "evaluaciones",
        "Match": {
          "Path": "/api/unidades/{**rest}"
        }
      },
      "temas": {
        "ClusterId": "evaluaciones",
        "Match": {
          "Path": "/api/temas/{**rest}"
        }
      },
      "contenidos": {
        "ClusterId": "evaluaciones",
        "Match": {
          "Path": "/api/contenidos/{**rest}"
        }
      },
      "actividades": {
        "ClusterId": "evaluaciones",
        "Match": {
          "Path": "/api/actividades/{**rest}"
        }
      },
      "calificaciones": {
        "ClusterId": "evaluaciones",
        "Match": {
          "Path": "/api/calificaciones/{**rest}"
        }
      },
      "rendimiento": {
        "ClusterId": "evaluaciones",
        "Match": {
          "Path": "/api/rendimiento/{**rest}"
        }
      },
      "seguimiento": {
        "ClusterId": "seguimiento",
        "Match": {
          "Path": "/api/seguimiento/{**rest}"
        }
      }
    },
    "Clusters": {
      "usuarios": {
        "Destinations": {
          "api": {
            "Address": "http://usuarios:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        }
      },
      "materias": {
        "Destinations": {
          "api": {
            "Address": "http://materias:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        }
      },
      "estudiantes": {
        "Destinations": {
          "api": {
            "Address": "http://estudiantes:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        }
      },
      "evaluaciones": {
        "Destinations": {
          "api": {
            "Address": "http://evaluaciones:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        }
      },
      "seguimiento": {
        "Destinations": {
          "api": {
            "Address": "http://seguimiento:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        }
      }
    }
  }
}
